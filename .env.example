# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO: REHABILITA SPORT
# Copia este archivo como .env y rellena con tus claves de Supabase y Netlify.
# NUNCA agregues claves reales con prefijo PUBLIC_ que contengan privilegios de service_role.
# ============================================================================

# Supabase (Público - Frontend)
PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica-aqui"

# Supabase (Privado - Exclusivo para Netlify Functions en servidor)
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada-aqui"

# Meta WhatsApp Cloud API (Privado - Exclusivo para Backend)
WHATSAPP_PHONE_NUMBER_ID="tu-phone-number-id"
WHATSAPP_ACCESS_TOKEN="tu-system-user-access-token"
WHATSAPP_RECEPTION_PHONE="NUMERO_DE_RECEPCION"

# Panel Administrativo (Privado - Exclusivo para Backend y Seguridad de Sesión)
# Contraseña para inicio de sesión en /admin. Requisito obligatorio: MÍNIMO 12 caracteres en producción (falla cerrada si < 12 o si se usa "admin123").
ADMIN_PASSWORD="cambiar_por_un_password_seguro_para_personal_clinica"
# Clave secreta criptográfica principal para firmar tokens HMAC-SHA256 de sesión.
# Requisito obligatorio: MÍNIMO 32 bytes (256 bits) UTF-8 / Hexadecimal en producción.
ADMIN_SESSION_SECRET="cambiar_por_un_secreto_criptografico_hex_de_32_bytes_o_mas"
# Clave secreta anterior (opcional, exclusivamente para validar sesiones activas durante la rotación de claves).
# Requisito obligatorio: MÍNIMO 32 bytes si se define.
# ADMIN_SESSION_SECRET_PREVIOUS="clave_secreta_anterior_durante_rotacion"

# Worker y Cron de Notificaciones (Privado - Exclusivo para Netlify Functions)
# Token secreto Bearer para autorizar ejecuciones manuales o peticiones HTTP directas al worker de notificaciones.
CRON_SECRET="cambiar_por_un_token_secreto_aleatorio_para_cron_o_worker"
